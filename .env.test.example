# KAL-257 — integration-test environment (npm run test:integration).
# Copy to .env.test (gitignored) and fill in the service key.
#
# TEST PROJECT ONLY. The guard in tests/phase27/integrationEnv.mjs refuses any
# host not on its allowlist, so pointing this at production cannot work.
# survey-test project dashboard: https://supabase.com/dashboard/project/zgdkyslxbkusexmkfvgd
# (service_role key: Project Settings → API, or `supabase projects api-keys --project-ref zgdkyslxbkusexmkfvgd`)
SUPABASE_TEST_URL=https://zgdkyslxbkusexmkfvgd.supabase.co
SUPABASE_TEST_SERVICE_KEY=
#
# If the run fails with network errors, the free-tier test project has likely
# been paused for inactivity — restore it in the dashboard, then re-provision:
#   SUPABASE_ACCESS_TOKEN=… node scripts/bootstrap-test-db.mjs --ref zgdkyslxbkusexmkfvgd --reset
#
# KAL-288 S2 — storage privacy tripwire (tests/storagePrivacyTripwire.test.mjs).
# READ-ONLY probes (GET + Range bytes=0-0 only), so production IS allowed here —
# the tripwire guards the production bucket; pointing it at survey-test guards
# nothing. Host allowlist in the test file refuses anything else.
# Values: VITE_SUPABASE_URL from .env, SUPABASE_SERVICE_ROLE_KEY from .env.local.
SUPABASE_PRIVACY_PROBE_URL=https://cvamwtpsuvxvjdnotbeg.supabase.co
SUPABASE_PRIVACY_PROBE_SERVICE_KEY=
