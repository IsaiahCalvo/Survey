{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "25f0ade2-e40f-45c8-832b-52188a970d47",
  "developer": {
    "name": "Kal Voe LLC",
    "websiteUrl": "https://surveytool.app",
    "privacyUrl": "https://surveytool.app/privacy.html",
    "termsOfUseUrl": "https://surveytool.app/terms.html"
  },
  "name": {
    "short": "Survey",
    "full": "Survey: PDF markup and site surveys"
  },
  "description": {
    "short": "Open your Survey projects, drawings, issues and tasks in Teams.",
    "full": "Survey is a PDF markup and site survey app for construction teams. Add it as a tab in a chat or channel to keep one project, one of its lists or one drawing in front of the team without leaving Teams. Marks and survey data stay live with the people working in the field and with your Excel sheet."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#12141A",
  "configurableTabs": [
    {
      "configurationUrl": "{{SITE}}/teams/config",
      "canUpdateConfiguration": true,
      "scopes": [
        "team",
        "groupChat"
      ],
      "context": [
        "channelTab",
        "privateChatTab",
        "meetingChatTab",
        "meetingDetailsTab"
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "survey",
      "name": "Survey",
      "contentUrl": "{{SITE}}/teams",
      "websiteUrl": "{{SITE}}/",
      "scopes": [
        "personal"
      ]
    }
  ],
  "validDomains": [
    "surveytool.app",
    "surveytool-nightly.vercel.app"
  ]
}
