  "build": {
    "appId": "com.example.survey",
    "icon": "build/icon.png",
    "extraMetadata": {
      "main": "src/electron-main.js"
    },
    "files": [
      "dist/**/*",
      "src/electron-main.js",
      "src/preload.js",
      "package.json",
      "build/icon.icns",
      "build/icon.png"
    ],
    "asar": true,
    "mac": {
      "target": "dmg",
