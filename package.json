{
  "name": "survey",
  "version": "0.1.0",
  "private": true,
  "main": "src/electron-main.js",
  "scripts": {
    "dev:ui": "vite",
    "dev:electron": "wait-on -t 30000 http://localhost:5173 && NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs",
    "test:debug": "npx playwright test --config debug/playwright.config.mjs",
    "debug:scenario": "npx playwright test --config debug/playwright.config.mjs --grep"
  },
