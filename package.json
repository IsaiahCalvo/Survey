{
  "name": "survey",
  "version": "0.1.47",
  "private": true,
  "main": "src/electron-main.js",
  "scripts": {
    "dev:ui": "vite",
    "dev:auth:configure": "node scripts/configure-dev-auth.mjs",
    "dev:electron": "wait-on -t 30000 http://localhost:5173 && NODE_ENV=development electron .",
    "predev": "node scripts/bootstrap-dev-env.mjs",
    "dev": "node find-port.js",
    "postinstall": "node scripts/bootstrap-dev-env.mjs",
    "prebuild": "node scripts/write-release-marker.mjs",
    "build": "vite build && node scripts/assert-no-pdfjs-demo-in-dist.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dist": "npm run build && electron-builder",
    "test": "node scripts/run-node-tests.mjs",
    "test:perf": "node scripts/run-node-tests.mjs --only-perf",
    "env:test:configure": "node scripts/configure-main-integration-env.mjs",
    "env:analytics:configure": "node scripts/configure-hosted-analytics-env.mjs",
    "release:mobile:readiness": "node scripts/verify-mobile-rollout-readiness.mjs --remote",
    "test:integration": "npm run env:test:configure --silent && SUPABASE_INTEGRATION=1 node --env-file=.env.test --test tests/phase27/byteaRoundTrip.test.mjs tests/phase27/schemaPresence.test.mjs tests/phase27/cryptYjsUpdatesSchema.test.mjs tests/storagePrivacyTripwire.test.mjs",
    "test:e2e:eraser-permissions": "npm run env:test:configure --silent && playwright test --config playwright.eraser-permissions.config.mjs",
    "test:e2e:home-skeletons": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:5197 playwright test --config debug/playwright.config.mjs debug/scenarios/home-loading-skeletons.spec.mjs",
    "test:privacy": "npm run env:test:configure --silent && SUPABASE_INTEGRATION=1 node --env-file=.env.test --test tests/storagePrivacyTripwire.test.mjs",
    "test:mobile-annotations": "node agent-cli/mobile-annotations-e2e.mjs",
    "test:mobile-secondary": "node agent-cli/mobile-annotations/secondary-selftest.mjs",
    "test:app-e2e": "node agent-cli/full-app-e2e.mjs --device=all",
    "test:app-e2e:fast": "node agent-cli/full-app-e2e.mjs --device=all",
    "test:app-e2e:durable": "node agent-cli/full-app-durable-e2e.mjs --surface=both",
    "benchmark:pdf-annotations": "node debug/benchmarks/run-production-240k.mjs",
    "audit:code": "npx fallow",
    "audit:dead": "npx fallow dead-code",
    "audit:dupes": "npx fallow dupes",
    "audit:health": "npx fallow health",
    "test:debug": "npx playwright test --config debug/playwright.config.mjs",
    "test:eraser-lifecycle": "npx playwright test --config debug/playwright.config.mjs debug/scenarios/eraser-lifecycle-gestures.spec.mjs",
    "test:print-fidelity": "node scripts/generate-print-fidelity-fixture.mjs && node scripts/run-print-fidelity.mjs",
    "test:print-pagination": "node scripts/run-print-fidelity.mjs debug/scenarios/print-pagination.spec.mjs debug/scenarios/browser-print-lazy.spec.mjs",
    "test:survey-marker": "node scripts/run-print-fidelity.mjs debug/scenarios/survey-marker-module.spec.mjs",
    "debug:scenario": "npx playwright test --config debug/playwright.config.mjs --grep",
    "debug:process": "node debug/lib/post-process.mjs",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:ios": "npx cap open ios",
    "mobile:ios:sim": "node scripts/run-ios-simulator.mjs",
    "mobile:ios:device": "node scripts/run-ios-device.mjs",
    "test:mobile-pinch-native": "node scripts/test-ios-native-pinch.mjs",
    "test:mobile-zoomout-native": "MOBILE_PINCH_FIXTURE=se011.pdf MOBILE_PINCH_ONLY=AppNativePinchUITests/NativePinchUITests/testSlowZoomOutFromDeepScaleDoesNotTerminateWebContentProcess node scripts/test-ios-native-pinch.mjs",
    "mobile:phone": "node scripts/publish-phone-update.mjs",
    "mobile:android": "npx cap open android"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.26.2",
    "@azure/msal-node": "^5.2.3",
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@supabase/supabase-js": "^2.81.1",
    "@survey/shared": "file:packages/shared",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "fabric": "7.4.0",
    "martinez-polygon-clipping": "^0.7.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.13.11",
    "tesseract.js": "^7.0.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.5",
    "license-checker": "^25.0.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "react-scan": "^0.5.7",
    "sharp": "^0.35.3",
    "vite": "8.1.3",
    "wait-on": "^7.0.1"
  },
  "overrides": {
    "tar": "^7.5.19",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.kalvoe.survey",
    "icon": "build/icon.png",
    "extraMetadata": {
      "main": "src/electron-main.js"
    },
    "files": [
      "dist/**/*",
      "src/electron-main.js",
      "src/electronAnalyticsBridge.js",
      "src/electron/atomicFileWriter.cjs",
      "src/electron/msalAuthMain.js",
      "src/electron/msalCacheStore.cjs",
      "src/electron/oauthWindowPolicy.cjs",
      "src/preload.js",
      "package.json",
      "build/icon.icns",
      "build/icon.png"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "IsaiahCalvo",
        "repo": "Survey",
        "releaseType": "release"
      }
    ]
  }
}
