# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.npm-cache/

# testing
/coverage

# production
# 2026-04-26 — Ignore everything inside /build EXCEPT the app icons. The
# GitHub Actions release workflow needs the icons to build Mac + Windows
# installers; everything else here is electron-builder output noise.
/build/*
!/build/README.md
!/build/icon.icns
!/build/icon.png
/dist

# misc
.DS_Store
.claude/scheduled_tasks.lock
.env
.env.local
.env.development.local
.env.test
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup logs and runtime files
scripts/backup.log
scripts/backup-stdout.log
scripts/backup-stderr.log
scripts/backup-cron.log
scripts/backup-daemon.pid

# Debug session output
debug/debug-sessions/

# Test artifacts (regenerated each run)
/TestLogs/
/test-results/
/playwright-report/
/debug/artifacts/

# Per-session debug log dumps left at the project root
/1.log
/[0-9]*.log

# git worktrees (sandboxes)
.worktrees/
.claude/worktrees/
.claude/projects/

# Phase 28 — bot account credentials for transport spike benchmark
# (5 dedicated test bots in real Supabase project, tagged with phase28_bot=true).
# NEVER commit — read by tests/phase28/transportSpikeBenchmark.mjs at runtime.
.planning/phases/28-transport-spike-auth-validator/.bot-credentials.json
.survey-test-account.json

# IDE / tooling caches (per-developer noise, never commit)
.cursor/
.playwright-mcp/
graphify-out/cache/stat-index.json

# Supabase CLI runtime cache (auto-bumped by local CLI installs)
supabase/.temp/

# User diagnostic snapshots from Cmd+Shift+L (dated subfolders, auto-pruned to 20)
/Logs/

# KAL-48 verification artifacts (transient: screenshots + scratch scripts)
/.kal48/

# 2026-05-28 — Audit run outputs are transient/regenerable. Keep tracked docs
# (audit/**/REPORT.md) and reusable scripts; ignore the heavy generated noise.
audit/**/logs/
audit/**/screenshots/
audit/**/artifacts/
audit/**/*.log

# Dev-only test fixture for ?testPdf= route (do not commit)
public/debug-fixtures/

# Generated on every build so production can prove which commit is live
public/release.json

# Main-process MSAL token cache (only ever in userData; ignore if a dev profile points into the repo)
ms-auth-cache.bin
ms-auth-cache.bin.tmp

# Renderer-parity harness screenshots (regenerated each run)
agent-cli/artifacts/

# content-hash maintenance reports carry live doc names/paths — local artifacts only
debug/content-hash/

# Vercel CLI project link — local machine metadata only
.vercel/
