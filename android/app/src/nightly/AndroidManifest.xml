<?xml version="1.0" encoding="utf-8"?>
<!-- Survey Nightly only (build.gradle adds this file when -PsurveyNightly is
     set). Nightly turns beta flags on, so testers get "Open in Survey" (flag
     'open-in-survey') from Files, Mail or Teams. The stable app leaves this
     out until the flag moves to 'rollout'; then move the filter into
     src/main/AndroidManifest.xml and delete this file
     (tests/nativeOpenFile.test.mjs checks both). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
