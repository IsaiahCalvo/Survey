    }
   }
  },
  {
   "say": "Camera six on four is mounted and has power, add a note it got hit by a ladder",
   "expect": {
    "c406": {
     "answers": {
      "cam-mounted": "Y",
      "cam-power": "Y"
     },
     "noteIncludes": [
      "ladder"
     ]
    }
   }
  },
  {
   "say": "the camera on the third floor number six is mounted but the cable isn't terminated",
   "expect": {
