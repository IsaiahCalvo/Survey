{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.21.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:remote": "EXPO_PUBLIC_SURVEY_URL='https://isaiahs-macbook-pro.taila0b324.ts.net/' expo start --dev-client --tunnel --port 8081",
    "start:remote:expo-go": "EXPO_PUBLIC_SURVEY_URL='https://isaiahs-macbook-pro.taila0b324.ts.net/' expo start --go --tunnel --port 8082",
    "start:simulator": "EXPO_PUBLIC_SURVEY_URL='http://127.0.0.1:5177/' expo start --dev-client --localhost --port 8084",
    "build:ios": "expo run:ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit && expo config --type public"
  },
  "private": true,
  "overrides": {
    "zod": "^4.6.6"
  }
}
