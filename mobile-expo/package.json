{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:remote": "EXPO_PUBLIC_SURVEY_URL='https://isaiahs-macbook-pro.taila0b324.ts.net/' expo start --dev-client --tunnel --port 8081",
    "start:remote:expo-go": "EXPO_PUBLIC_SURVEY_URL='https://isaiahs-macbook-pro.taila0b324.ts.net/' expo start --go --tunnel --port 8082",
    "start:simulator": "EXPO_PUBLIC_SURVEY_URL='http://127.0.0.1:5177/' expo start --dev-client --localhost --port 8084",
    "build:ios": "expo run:ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit && expo config --type public"
  },
  "private": true
}
